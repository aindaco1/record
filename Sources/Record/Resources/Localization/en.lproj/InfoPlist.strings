<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Record captures system audio for local recordings and on-device transcription. Audio never leaves this Mac.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record captures microphone audio for local recordings and on-device transcription. Audio never leaves this Mac.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Record captures screenshots and screen recordings of displays, windows, apps, or areas you select. Images and video never leave this Mac.</string>
</dict>
</plist>
