  "strings": {
    "\n\nYou can manage Record manually in System Settings → General → Login Items.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nYou can manage Record manually in System Settings → General → Login Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nPuedes configurar Record en Configuración del Sistema → General → Ítems de inicio."
          }
        }
      }
    },
